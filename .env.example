# Banco de dados
# DATABASE_URL: usada pela aplicação. Em serverless (Vercel), use a URL COM pooler.
# DIRECT_URL:   usada pelas migrations, sempre SEM pooler.
# Sem pooler (VPS, local), as duas recebem o mesmo valor.
DATABASE_URL="postgresql://usuario:senha@localhost:5432/wr_consorcio?schema=public&connection_limit=20&pool_timeout=20"
DIRECT_URL="postgresql://usuario:senha@localhost:5432/wr_consorcio?schema=public"

# Sessão (gere com: openssl rand -base64 48)
AUTH_SECRET="troque-esta-chave-por-uma-aleatoria-de-no-minimo-32-caracteres"
AUTH_SESSION_MAX_AGE_SECONDS="28800"

# Backup
BACKUP_DIR="./storage/backups"
BACKUP_RETENTION_DAYS="30"
# Token usado pelo agendador externo (cron) para disparar o backup diário
BACKUP_CRON_TOKEN=""

# Uploads
UPLOAD_MAX_BYTES="52428800"
