# Banco de dados
# DATABASE_URL: usada pela aplicação. Em serverless (Vercel), use a URL COM pooler.
# DIRECT_URL:   usada pelas migrations, sempre SEM pooler.
# Sem pooler (VPS, local), as duas recebem o mesmo valor.
DATABASE_URL="postgresql://usuario:senha@localhost:5432/wr_consorcio?schema=public&connection_limit=20&pool_timeout=20"
DIRECT_URL="postgresql://usuario:senha@localhost:5432/wr_consorcio?schema=public"

# Sessão (gere com: openssl rand -base64 48)
AUTH_SECRET="troque-esta-chave-por-uma-aleatoria-de-no-minimo-32-caracteres"
AUTH_SESSION_MAX_AGE_SECONDS="28800"

# Backup
BACKUP_DIR="./storage/backups"
BACKUP_RETENTION_DAYS="30"
# Token usado pelo agendador externo (cron) para disparar o backup diário
BACKUP_CRON_TOKEN=""

# Uploads
UPLOAD_MAX_BYTES="52428800"

# ---------------------------------------------------------------------------
# Atendimento automatizado via WhatsApp
# ---------------------------------------------------------------------------

# URL pública da aplicação. É a base dos webhooks e das URLs de retorno do
# pagamento — precisa ser acessível pela internet em produção.
APP_URL="http://localhost:3000"

# WhatsApp. Sem nada configurado, o módulo sobe em modo simulação: as mensagens
# são gravadas na conversa e nenhuma sai do servidor.
# Valores: EVOLUTION | CLOUD_API | SIMULADOR
WHATSAPP_PROVIDER=""
WHATSAPP_API_URL=""
WHATSAPP_API_KEY=""
WHATSAPP_INSTANCE=""
# Token exigido no webhook de entrada. Vazio deixa o endpoint aberto — só faça
# isso em desenvolvimento.
WHATSAPP_WEBHOOK_TOKEN=""

# Gateway de pagamento.
# Valores: STRIPE | SIMULADOR | MANUAL
# SIMULADOR gera cobranças fictícias que só são confirmadas à mão, para
# percorrer o fluxo sem credencial. Nunca use em produção.
PAYMENT_PROVIDER=""
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Minutos até a cobrança expirar sem pagamento.
PAGAMENTO_EXPIRA_MINUTOS="60"

# Credenciais do administrador criado pelo seed. Sem senha definida, o seed
# gera uma forte e a exibe uma única vez.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_SENHA=""
SEED_ADMIN_NOME=""

# ---------------------------------------------------------------------------
# Docker Compose
# ---------------------------------------------------------------------------
POSTGRES_USER="automa"
POSTGRES_PASSWORD=""
POSTGRES_DB="automa"
